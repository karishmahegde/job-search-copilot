# Job Search Copilot — environment variables
# Copy this file to .env and fill in your own real values.
# .env is gitignored — never commit real values, not even temporarily.
# Placeholders below are illustrative only; they are not real credentials.

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# --- LLM provider(s) — set only the ones your profile.yaml references ---
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
# Ollama runs locally and typically needs no key; set OLLAMA_HOST only if
# it's not running on the default localhost port.
OLLAMA_HOST=http://localhost:11434

# --- Email delivery (digest notifications) ---
GMAIL_ADDRESS=your-address@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password-here

# --- Local listener (autofill bridge) ---
LOCAL_LISTENER_TOKEN=generate-a-random-token-here

# --- Opt-In Shared Mode (only needed if mode: shared in profile.yaml) ---
# Each partner's read-only key is referenced from profile.yaml as
# ${VAR_NAME} — add one line per configured partner, e.g.:
# PARTNER_EXAMPLE_SUPABASE_READONLY_KEY=partner-readonly-key-here
